services:
  gluetun:
    image: qmcgaw/gluetun@sha256:fa19cc76b2af13d57a8d3dc3066f2ada061b1c761b8aecf989b3877c0486e027  # v3.41.3
    container_name: gluetun
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    ports:
      - 9091:9091
      - 51413:51413
      - 51413:51413/udp
    environment:
      - VPN_SERVICE_PROVIDER=surfshark
      - VPN_TYPE=wireguard
      - WIREGUARD_PRIVATE_KEY={{ wg_private_key }}
      - WIREGUARD_ADDRESSES={{ wg_addresses }}
      - SERVER_COUNTRIES={{ server_countries }}
    volumes:
      - gluetun_data:/gluetun
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "/gluetun-entrypoint", "healthcheck"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
  transmission:
    image: lscr.io/linuxserver/transmission@sha256:aaf349cd859ca9d5f34f394c56b8097c267a513283698adc4d07ee61d7cb1a85  # 4.1.4-r0-ls369
    container_name: transmission
    network_mode: "service:gluetun"
    depends_on:
      gluetun:
        condition: service_healthy
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Warsaw
      - USER={{ transmission_user }}
      - PASS={{ transmission_pass }}
    volumes:
      - transmission_config:/config
      - /mnt/nas/downloads:/downloads
      - /mnt/nas/downloads/watch:/watch
    restart: unless-stopped
volumes:
  gluetun_data:
  transmission_config:
networks:
  default:
    name: torrentbox
