services:
  samba:
    image: dperson/samba@sha256:66088b78a19810dd1457a8f39340e95e663c728083efa5fe7dc0d40b2478e869  # latest
    container_name: samba
    restart: unless-stopped
    ports:
      - "139:139"
      - "445:445"
    volumes:
      - /mnt/nas:/mount/nas
    environment:
      - TZ=Europe/Warsaw
    command: -s "NAS;/mount/nas;yes;no;yes"
