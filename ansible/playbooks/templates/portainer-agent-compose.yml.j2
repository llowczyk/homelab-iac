services:
  portainer-agent:
    image: portainer/agent@sha256:43c8bc9bafde891ddd0fc3dcc61ac6e1887e7e2027baa76ce402bc014037fba6
    container_name: portainer-agent
    restart: unless-stopped
    group_add:
      - "988"
    ports:
      - "9001:9001"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /var/lib/docker/volumes:/var/lib/docker/volumes
