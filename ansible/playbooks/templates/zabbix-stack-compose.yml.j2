version: '3.9'
services:
  zabbix-db:
    image: postgres@sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685
    container_name: zabbix-db
    ports:
      - "5433:5432"
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
      PGDATA: /var/lib/postgresql/data/pgdata
    volumes:
      - zabbix-db-data:/var/lib/postgresql/data
    networks:
      - zabbix-net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER}"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped
  zabbix-server:
    image: zabbix/zabbix-server-pgsql@sha256:401dc90cff398aaf6a0fa72625f4b9b57407e61231f94e13e7f4e68aeff0c42c  # alpine-7.0.32
    container_name: zabbix-server
    environment:
      DB_SERVER_HOST: zabbix-db
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
    depends_on:
      zabbix-db:
        condition: service_healthy
    volumes:
      - ./ssh_keys:/var/lib/zabbix/ssh_keys
    ports:
      - "10051:10051"
    networks:
      - zabbix-net
    restart: unless-stopped
  zabbix-web:
    image: zabbix/zabbix-web-nginx-pgsql@sha256:a54ce2e19aaf0a61609e4bbc7ec01c16bef504e6e1c51e3854120ac76d2dbaeb  # alpine-7.0.32
    container_name: zabbix-web
    environment:
      DB_SERVER_HOST: zabbix-db
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
      ZBX_SERVER_HOST: "zabbix-server,172.21.0.1"
      PHP_TZ: ${PHP_TZ}
    depends_on:
      - zabbix-server
    ports:
      - "8080:8080"
    networks:
      - zabbix-net
    restart: unless-stopped
  zabbix-agent:
    image: zabbix/zabbix-agent2@sha256:aa8fa07dbd41e148b6156555bf10ba6d928efa40f9a4632d6787fb90d4756679  # alpine-7.0.32
    container_name: zabbix-agent
    privileged: true
    group_add:
      - "988"
    environment:
      ZBX_SERVER_HOST: "zabbix-server,172.21.0.1"
      ZBX_HOSTNAME: ${AGENT_HOSTNAME}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /:/rootfs:ro
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
    ports:
      - "10050:10050"
    networks:
      - zabbix-net
    restart: unless-stopped
volumes:
  zabbix-db-data:
networks:
  zabbix-net:
