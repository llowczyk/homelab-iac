services:
  dbgate:
    image: dbgate/dbgate@sha256:e88589ff45f5de78ceb0925af8da693d112d0e6c9a5647f5e9e19ceb590dc1d5  # 7.3.5
    container_name: dbgate
    environment:
      - TZ=Europe/Warsaw
    volumes:
      - dbgate_data:/root/.dbgate
    ports:
      - "8090:3000"
    networks:
      - infra
    restart: unless-stopped
volumes:
  dbgate_data:
networks:
  infra:
    external: true
