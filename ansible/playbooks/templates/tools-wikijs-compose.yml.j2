services:
  wikijs:
    image: ghcr.io/requarks/wiki@sha256:e4708eed80c014449c0c8426c8d466c7a52a62131555bb44372fa48378b448b8  # 2.5.317
    container_name: wikijs
    depends_on:
      - wikijs-db
    environment:
      DB_TYPE: postgres
      DB_HOST: wikijs-db
      DB_PORT: 5432
      DB_USER: {{ wikijs_postgres_user }}
      DB_PASS: {{ wikijs_postgres_password }}
      DB_NAME: {{ wikijs_postgres_db }}
    ports:
      - "8083:3000"
    networks:
      - infra
    restart: unless-stopped
  wikijs-db:
    image: postgres@sha256:eab009ce9447a891d9482702d370bbf132c18563bb87cfdcc2b815c6d3b0372f  # 15.19-alpine
    container_name: wikijs-db
    environment:
      POSTGRES_USER: {{ wikijs_postgres_user }}
      POSTGRES_PASSWORD: {{ wikijs_postgres_password }}
      POSTGRES_DB: {{ wikijs_postgres_db }}
    volumes:
      - ./wikijs-data:/var/lib/postgresql/data
    networks:
      - infra
    restart: unless-stopped
networks:
  infra:
    external: true
