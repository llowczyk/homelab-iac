services:
  zabbix-agent:
    image: zabbix/zabbix-agent2@sha256:1a6259be4c8da5267cdd25064d995a111e8c803df8b9c4072d10084f685ffab4
    container_name: zabbix-agent
    privileged: true
    group_add:
      - "988"
    environment:
      ZBX_SERVER_HOST: 192.168.10.104
      ZBX_HOSTNAME: "{{ inventory_hostname }}"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /:/rootfs:ro
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
    ports:
      - "10050:10050"
    restart: unless-stopped
