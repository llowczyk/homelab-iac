services:
  diun:
    image: crazymax/diun@sha256:e324b793eb32dfb7f74d3a39421ebf090141caaadee69b8f78da63112408ee25
    container_name: diun
    command: serve
    group_add:
      - "988"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      - TZ=Europe/Warsaw
      - LOG_LEVEL=info
      - DIUN_WATCH_SCHEDULE=0 0 8,20 * * *
      - DIUN_PROVIDERS_DOCKER=true
      - DIUN_PROVIDERS_DOCKER_WATCHBYDEFAULT=true
    restart: unless-stopped
