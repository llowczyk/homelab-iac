services:
  diun:
    image: crazymax/diun@sha256:8cc638b4c54e8a0c47898a51b20dae73037ad43310168b5da543a311dc668f77  # 4.33.1
    container_name: diun
    command: serve
    group_add:
      - "988"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      - TZ=Europe/Warsaw
      - LOG_LEVEL=info
      - DIUN_WATCH_SCHEDULE=0 0 8,20 * * *
      - DIUN_PROVIDERS_DOCKER=true
      - DIUN_PROVIDERS_DOCKER_WATCHBYDEFAULT=true
    restart: unless-stopped
